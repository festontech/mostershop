<!-- views/index.ejs - Homepage -->
<div class="home-page">
  <!-- Hero Section -->
  <div class="hero-section bg-primary text-white text-center py-5 mb-4">
    <h1 class="display-4">Welcome to Our E-commerce Store</h1>
    <p class="lead">Your one-stop destination for quality products</p>
    <a href="/products" class="btn btn-light btn-lg">Browse Products</a>
  </div>

  <!-- Featured Products Section -->
  <section class="featured-products mb-5">
    <h2 class="text-center mb-4">Featured Products</h2>
    <div class="row">
      <% if (featuredProducts && featuredProducts.length > 0) { %>
        <% featuredProducts.forEach(product => { %>
          <div class="col-md-4 mb-4">
            <div class="card h-100">
              <img src="<%= product.imageUrl %>" class="card-img-top" alt="<%= product.name %>">
              <div class="card-body d-flex flex-column">
                <h5 class="card-title"><%= product.name %></h5>
                <p class="card-text text-muted mb-2"><%= product.category %></p>
                <p class="card-text flex-grow-1"><%= product.description.substring(0, 100) %>...</p>
                <div class="d-flex justify-content-between align-items-center mt-auto">
                  <h4 class="mb-0">$<%= product.price.toFixed(2) %></h4>
                  <a href="/products/<%= product._id %>" class="btn btn-primary">View Details</a>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="col-12 text-center">
          <p>No featured products available at the moment.</p>
        </div>
      <% } %>
    </div>
  </section>

  <!-- Recent Products Section -->
  <section class="recent-products">
    <h2 class="text-center mb-4">New Arrivals</h2>
    <div class="row">
      <% if (recentProducts && recentProducts.length > 0) { %>
        <% recentProducts.forEach(product => { %>
          <div class="col-md-3 mb-4">
            <div class="card h-100">
              <img src="<%= product.imageUrl %>" class="card-img-top" alt="<%= product.name %>">
              <div class="card-body d-flex flex-column">
                <h5 class="card-title"><%= product.name %></h5>
                <p class="card-text text-muted mb-2"><%= product.category %></p>
                <div class="d-flex justify-content-between align-items-center mt-auto">
                  <h4 class="mb-0">$<%= product.price.toFixed(2) %></h4>
                  <a href="/products/<%= product._id %>" class="btn btn-sm btn-outline-primary">View</a>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="col-12 text-center">
          <p>No new products available at the moment.</p>
        </div>
      <% } %>
    </div>
    <div class="text-center mt-4">
      <a href="/products" class="btn btn-outline-dark btn-lg">View All Products</a>
    </div>
  </section>
</div>