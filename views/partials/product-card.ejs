<!-- _product-card.ejs -->
<div class="product-card">
    <div class="product-image">
        <img src="<%= (product.imageUrl && product.imageUrl[0]) || '/images/product-placeholder.jpg' %>" alt="<%= product.name %>" style="max-width: 100%; height: 100%;object-fit: cover;">
        <% if (product.discount > 0) { %>
        <div class="product-badge">-<%= product.discount %>%</div>
        <% } else if (product.isNew) { %>
        <div class="product-badge">New</div>
        <% } %>
        <div class="product-actions">
            <a href="/shop/product/<%= product._id %>" class="product-action" title="Quick View">
                <i class="fas fa-eye"></i>
            </a>
            <a href="#" class="product-action" title="Add to Wishlist">
                <i class="far fa-heart"></i>
            </a>
             <% if (isAdmin) { %>
            <a href="/admin/products/edit/<%= product._id %>" class="product-action" title="Edit Product">
                <i class="fas fa-sync-alt"></i>
            </a>
            <% } %>
        </div>
    </div>
    <div class="product-content">
        <h2 class="product-title">
            <a href="/shop/product/<%= product._id %>"><%= product.name %></a>
        </h2>
        <div class="product-price">
            <div>
                <% if (product.discount > 0) { %>
                  <span class="price-old">$<%= product.price.toFixed(2) %></span>
                  <span class="price">$<%= (product.price * (1 - product.discount / 100)).toFixed(2) %></span>
                <% } else { %>
                  <span class="price">$<%= product.price.toFixed(2) %></span>
                <% } %>
            </div>
            <button class="add-to-cart" data-id="<%= product._id %>">
                <i class="fas fa-shopping-cart"></i> 
            </button>
        </div>
    </div>
</div>
