<div class="container mt-5">
  <h2>Order Details</h2>
  <div class="card mb-4">
    <div class="card-body">
      <h5 class="card-title">Order #<%= order._id %></h5>
      <p><strong>Status:</strong> <span class="badge"><%= order.status %></span></p>
      <p><strong>Total:</strong> $<%= order.total.toFixed(2) %></p>
      <p><strong>Placed on:</strong> <%= new Date(order.createdAt).toLocaleString() %></p>
      <p><strong>Customer:</strong> <%= order.user?.naam || 'N/A' %> (<%= order.user?.email || '' %>)</p>
    </div>
  </div>

  <h4>Items</h4>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Product</th>
        <th>Unit Price</th>
        <th>Qty</th>
        <th>Subtotal</th>
      </tr>
    </thead>
    <tbody>
      <% order.items.forEach(item => { %>
        <tr>
          <td><%= item.name %></td>
          <td>$<%= item.price.toFixed(2) %></td>
          <td><%= item.quantity %></td>
          <td>$<%= (item.price * item.quantity).toFixed(2) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <a href="/orders" class="btn btn-secondary mt-3">← Back to My Orders</a>
</div>