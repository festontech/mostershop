
<p class="page-description">
    Monster shop is your one-stop destination for all things monster energy. From the latest flavors to exclusive merchandise, we have everything you need to fuel your monster lifestyle.
</p>
<a href="/shop" class="btn btn-secondary">View All Products</a>
<h1 class="page-title">Featured Products</h1>
<span class="page-description">Explore our exclusive collection of featured products.</span>
<div class="product-grid">
    <% if (featuredProducts && featuredProducts.length > 0) { %>
        <% featuredProducts.forEach(product => { %>
            <%- include('../partials/product-card', { product: product }) %>
        <% }) %>
    <% } else { %>
        <p>No products found.</p>
    <% } %>
</div>
