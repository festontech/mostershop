<div class="cart-page container">
    <h1>Your Shopping Cart</h1>

    <% if (!cart || !cart.items || cart.items.length === 0) { %>
    <p>Your cart is empty.</p>
    <a href="/shop" class="btn">Continue Shopping</a>
    <% } else { %>
        <table class="cart-table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Name</th>
                    <th>Price</th>
                    <th>Qty</th>
                    <th>Subtotal</th>
                    <th>Remove</th>
                </tr>
            </thead>
            <tbody>
                <% cart.items.forEach(item => { %>
                    <tr>
                        <td>
                            <img src="<%= item.image || '/images/product-placeholder.jpg' %>" alt="<%= item.name %>" class="cart-img">
                        </td>
                        <td><%= item.name %></td>
                        <td>$<%= item.price.toFixed(2) %></td>
                        <td>
                            <form action="/cart/update/<%= item.productId %>" method="POST">
                              <input type="hidden" name="itemId" value="<%= item.productId %>">
                              <input type="number" name="quantity" value="<%= item.quantity %>" min="0" class="qty-input">
                              <button type="submit">Update</button>
                            </form>
                        </td>
                        <td>$<%= (item.price * item.quantity).toFixed(2) %></td>
                        <td>
                            <form action="/cart/remove/<%= item.productId %>" method="POST">
                                <input type="hidden" name="id" value="<%= item.id %>">
                                <button type="submit" class="remove-btn">×</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>

        <div class="cart-summary">
            <h3>Total: $<%= cart.total.toFixed(2) %></h3>
            <a href="/checkout" class="btn btn-primary">Proceed to Checkout</a>
        </div>
    <% } %>
</div>