<h1 class="page-title">Products</h1>

<div class="product-grid">
    <% if (products && products.length > 0) { %>
        <% products.forEach(product => { %>
            <%- include('../partials/product-card', { product: product }) %>
        <% }) %>
    <% } else { %>
        <p>No products found.</p>
    <% } %>
</div>
