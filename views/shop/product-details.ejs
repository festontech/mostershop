<div class="product-detail container mt-5">
  <div class="row">
    <div class="col-md-6">
      <div class="main-image mb-3">
        <img id="mainImage" src="<%= product.imageUrl[0] || '/images/product-placeholder.jpg' %>" alt="<%= product.name %>" class="img-fluid">
      </div>
      <div class="slider-bullets d-flex">
        <% if (product.imageUrl[0]) { %>
          <div class="bullet me-2 active" data-src="<%= product.imageUrl[0] %>">
            <img src="<%= product.imageUrl[0] %>" alt="thumb-0" class="thumb-img">
          </div>
        <% } %>
        <% if (product.imageUrl[1]) { %>
          <div class="bullet me-2" data-src="<%= product.imageUrl[1] %>">
            <img src="<%= product.imageUrl[1] %>" alt="thumb-1" class="thumb-img">
          </div>
        <% } %>
        <% if (product.imageUrl[2]) { %>
          <div class="bullet me-2" data-src="<%= product.imageUrl[2] %>">
            <img src="<%= product.imageUrl[2] %>" alt="thumb-2" class="thumb-img">
          </div>
        <% } %>
        <% if (product.imageUrl[3]) { %>
          <div class="bullet me-2" data-src="<%= product.imageUrl[3] %>">
            <img src="<%= product.imageUrl[3] %>" alt="thumb-3" class="thumb-img">
          </div>
        <% } %>
      </div>
    </div>

    <div class="col-md-6">
      <h1><%= product.name %></h1>
      <p class="text-muted"><strong>Category:</strong> <%= product.category?.name || 'Uncategorized' %></p>
      <div class="product-price mb-3">
        <% if (product.oldPrice) { %>
          <span class="text-decoration-line-through me-2">$<%= product.oldPrice.toFixed(2) %></span>
        <% } %>
        <span class="fs-4">$<%= product.price.toFixed(2) %></span>
      </div>
      <p><%= product.description || 'No description available.' %></p>
      <form action="/cart/add/<%= product._id %>" method="POST">
  <div class="d-flex align-items-center mb-3">
    <input
      type="number"
      name="quantity"
      class="form-control w-25 me-2"
      value="1"
      min="1"
      required
    >
    <button class="btn btn-primary" type="submit">
      <i class="fas fa-shopping-cart me-1"></i> Add to Cart
    </button>
  </div>
</form>
      <% if (product.discount > 0) { %>
        <div class="badge bg-danger mt-3">-<%= product.discount %>%</div>
      <% } else if (product.isNew) { %>
        <div class="badge bg-info mt-3">New</div>
      <% } %>
    </div>
  </div>
</div>