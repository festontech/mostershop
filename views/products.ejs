  <!-- Product Listing -->
  <section class="products-list">
    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>
    
    <div class="products-count">
      <p>Showing <%= products.length %> of <%= totalProducts || 0 %> products</p>
    </div>
    
    <div class="product-grid">
